{
  "name": "whiteroom",
  "version": "1.5.8",
  "description": "Dynamic visual effects image viewer",
  "author": "ne_peer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ne-peer/WhiteRoom.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron-vite.cjs dev",
    "build": "node scripts/electron-vite.cjs build",
    "preview": "node scripts/electron-vite.cjs preview",
    "package": "electron-builder",
    "extract:sut-presets": "node scripts/extract-sut-presets.cjs"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "immer": "^10.0.4",
    "pixi.js": "^8.4.0",
    "sql.js": "^1.11.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.8"
  },
  "build": {
    "appId": "com.whiteroom.app",
    "productName": "WhiteRoom",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "WhiteRoom Setup_v${version}.${ext}"
    },
    "portable": {
      "artifactName": "WhiteRoom for Windows_v${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": "dmg",
      "artifactName": "WhiteRoom for Mac_${arch}_v${version}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": "AppImage"
    }
  }
}
